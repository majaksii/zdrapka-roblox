--// Cykl: BuyCard(-7 zł) → UseCard(id z inventory) → CompleteScratch() → kasa.
local scrStatLbl, scrLastLbl, scrKasaLbl = nil, nil, nil
local scrInvN = 0 -- ile wybranej zdrapki w ekwipunku (odświeżane co cykl)

-- WSZYSTKIE zdrapki ze sklepu, po cenie rosnąco (klucze z ScratchCardConfig).
-- Nazwy/ceny brane na żywo z configu (cardDispName/cardCost), tu tylko kolejność.
local CARDS = {
    "Siodemeczki", "SlodkaKicia", "Scratchemon", "SzopZlodziej", "KochanyKosmita",
    "SlodkiPiesio", "PolskiPingwin", "Emotki", "Szescdziesiona", "Minescratch",
    "CapybaraNumbers", "OlympusGold", "SlodkiChomiczek", "KawaiiSushi", "Osaka",
    "SlodkaZabcia", "Plakal", "HotPepper", "SmiesznySzczurek", "KawaNaLawe",
    "Piraci", "Akihabara", "BabkuSzokoladku", "SuperMariusz", "MiBombaclat",
    "Pizza", "SlodkiKangurek", "KonieWalenie", "JadaNaRyby", "LuckyClover",
    "Samurai", "GoldGoldGold", "DzienKota", "KonieWalenie2077", "RichBilionier",
}
local CARDI = 1
local COSTC = {}

local function cardCfg(k)
    local ok, t = pcall(function()
        return require(ReplicatedStorage:WaitForChild("ScratchCards"):WaitForChild("ScratchCardConfig")).CardTypes[k]
    end)
    if ok and type(t) == "table" then return t end
    return nil
end

local function cardCost(k)
    if COSTC[k] then return COSTC[k] end
    local t = cardCfg(k)
    local c = (t and tonumber(t.Cost)) or 7
    COSTC[k] = c
    return c
end

local function cardDispName(k)
    local t = cardCfg(k)
    if t and t.Name then return tostring(t.Name) .. " (" .. tostring(cardCost(k)) .. " zł)" end
    return tostring(k)
end

