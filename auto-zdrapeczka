--// AUTO-SPRZEDAŻ: jazda do Butelkomatu, sprzedaż hurtem, powrót na pole //--
local function goSell()
    local h0 = hrp()
    if not h0 then return end
    if countTools() == 0 then
        lastSellCount = collectedTotal -- nie ma czego sprzedawać, nie jedź
        return
    end
    local back = h0.Position
    local pr, mp = findSellPrompt()
    if not pr or not mp then
        setStatus("Brak Butelkomatu!", Color3.fromRGB(255, 120, 120))
        return
    end
    setStatus("Jadę sprzedać (+" .. (collectedTotal - lastSellCount) .. ")...", Color3.fromRGB(255, 170, 70))
    pcall(tweenTo, mp + Vector3.new(0, 3, 4)) -- stajesz ~5m od maszyny (prompt ma 7-8m)
    standUp()
    -- 1) hurtem grupowym (zwykle czyści wszystko na raz)
    for _ = 1, 2 do
        if countTools() == 0 then break end
        fireSingle(pr)
        task.wait(1.0)
    end
    -- 2) fallback pojedynczo (max 25, żeby nie utknąć)
    local guard = 0
    while countTools() > 0 and guard < 25 and running and not stopReq do
        guard = guard + 1
        local ch = plr.Character
        local hu = ch and ch:FindFirstChildOfClass("Humanoid")
        local bp = plr:FindFirstChild("Backpack")
        local tool = nil
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") and t:GetAttribute("BottleType") ~= nil then tool = t break end
            end
        end
        if tool and hu then
            pcall(function() hu:EquipTool(tool) end)
            task.wait(0.3)
        end
        local bm = Workspace:FindFirstChild("Butelkomat")
        local single = nil
        if bm then
            for _, d in ipairs(bm:GetDescendants()) do
                if d:IsA("ProximityPrompt") and d.Parent.Name == "prompt" then single = d break end
            end
        end
        if single then fireSingle(single) end
        task.wait(0.4)
    end
    lastSellCount = collectedTotal
    setStatus("Sprzedane (" .. countTools() .. " zostało), wracam...", Color3.fromRGB(120, 220, 130))
    pcall(tweenTo, back)
end

