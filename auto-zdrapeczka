local function countTools()
    local n = 0
    local bp = plr:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and t:GetAttribute("BottleType") ~= nil then n = n + 1 end
        end
    end
    local ch = plr.Character
    if ch then
        for _, t in ipairs(ch:GetChildren()) do
            if t:IsA("Tool") and t:GetAttribute("BottleType") ~= nil then n = n + 1 end
        end
    end
    return n
end

-- grupowy ("...wszystkie...") sprzedaje hurtem; fallback = pierwszy prompt maszyny
local function findSellPrompt()
    local bm = Workspace:FindFirstChild("Butelkomat")
    if not bm then return nil, nil end
    local pos = nil
    pcall(function() pos = bm:GetPivot().Position end)
    local best = nil
    for _, d in ipairs(bm:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            if d.ActionText and d.ActionText:find("wszystkie") then return d, pos end
            best = best or d
        end
    end
    return best, pos
end

