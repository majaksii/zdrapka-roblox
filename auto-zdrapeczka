local TYPECOLORS = {
    normalna = { 90, 255, 150 }, srebrna = { 220, 225, 235 },
    zlota = { 255, 200, 40 }, diamentowa = { 150, 220, 255 },
    teczowa = { 255, 130, 220 }, galaktyczna = { 170, 90, 255 },
    lsniaca = { 255, 255, 220 }, toksyczna = { 80, 255, 120 },
    antymaterialna = { 200, 60, 255 },
}
local function norm(s)
    -- łańcuch DOSŁOWNYCH 2-bajtowych sekwencji (działa na bajtach, bezpieczny w UTF-8)
    s = tostring(s or "normalna"):lower()
    s = s:gsub("ą", "a"):gsub("ć", "c"):gsub("ę", "e"):gsub("ł", "l"):gsub("ń", "n")
    s = s:gsub("ó", "o"):gsub("ś", "s"):gsub("ź", "z"):gsub("ż", "z")
    s = s:gsub("Ą", "a"):gsub("Ć", "c"):gsub("Ę", "e"):gsub("Ł", "l"):gsub("Ń", "n")
    s = s:gsub("Ó", "o"):gsub("Ś", "s"):gsub("Ź", "z"):gsub("Ż", "z")
    return s
end

local function bottlePos(model)
    local ok, cf = pcall(function() return model:GetPivot() end)
    if ok and cf then return cf.Position end
    local pp = model:FindFirstChildWhichIsA("BasePart", true)
    if pp then return pp.Position end
    return nil
end

local function bottlePrompt(model)
    -- prompt jest DIRECT child Modelu (wg .rbxlx), ale dajemy fallback rekurencyjny
    local p = model:FindFirstChildOfClass("ProximityPrompt")
    if p then return p end
    return model:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function scanBottles()
    local out = {}
    local folder = Workspace:FindFirstChild("Butelki")
    if not folder then return out end
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") and m.Name == "Butelka" then
            local pos = bottlePos(m)
            if pos then
                local bt = nil
                pcall(function() bt = m:GetAttribute("BottleType") end)
                local nbt = norm(bt)
                out[#out + 1] = {
                    model = m, prompt = bottlePrompt(m), pos = pos,
                    btype = nbt, value = VALUES[nbt] or 0.5,
                }
            end
        end
    end
    return out
end

--// PLANOWANIE TRASY: gęstość + greedy NN (optymalne bez lagów) //--
local function planRoute(bottles, fromPos)
    local n = #bottles
    if n == 0 then return {} end
    if n == 1 then return { bottles[1] } end

    -- PRIORYTET SPECJALNYCH: droższe butelki (Złota/Srebrna/...) ZAWSZE przed zwykłymi
    if CFG.SpecFirst then
        local sp, nm = {}, {}
        for _, b in ipairs(bottles) do
            if (b.value or 0.5) > 0.5 then sp[#sp + 1] = b else nm[#nm + 1] = b end
        end
        if #sp > 0 then
            local function greedySP(list, start)
                local remaining = {}
                for _, v in ipairs(list) do remaining[#remaining + 1] = v end
                local route, cur = {}, start
                while #remaining > 0 do
                    local bi, bd = 1, math.huge
                    for i, b in ipairs(remaining) do
                        local d = (cur - b.pos).Magnitude
                        if d < bd then bd, bi = d, i end
                    end
                    local pick = table.remove(remaining, bi)
                    route[#route + 1] = pick
                    cur = pick.pos
                end
                return route
            end
            local r1 = greedySP(sp, fromPos)
            local ts = r1[#r1].pos
            for _, v in ipairs(greedySP(nm, ts)) do r1[#r1 + 1] = v end
            return r1
        end
    end

    local orderPool = bottles

    if CFG.ClusterMode and n > 4 then
        -- 1) grid-hash: zlicz sąsiadów w promieniu ClusterR (szybciej niż O(n^2) pełne dla 250)
        local R = CFG.ClusterR
        local cell = math.max(R, 10)
        local buckets = {}
        local function key(p)
            return math.floor(p.X / cell) .. "," .. math.floor(p.Z / cell)
        end
        for _, b in ipairs(bottles) do
            local k = key(b.pos)
            local t = buckets[k]
            if not t then t = {}; buckets[k] = t end
            t[#t + 1] = b
        end
        -- 2) znajdź najgęstszy punkt (najwięcej sąsiadów w R)
        local best, bestCount = nil, -1
        local R2 = R * R
        for _, b in ipairs(bottles) do
            local cnt = 0
            local cx, cz = math.floor(b.pos.X / cell), math.floor(b.pos.Z / cell)
            for dx = -1, 1 do
                for dz = -1, 1 do
                    local t = buckets[(cx + dx) .. "," .. (cz + dz)]
                    if t then
                        for _, o in ipairs(t) do
                            local d = b.pos - o.pos
                            if (d.X * d.X + d.Z * d.Z) <= R2 then cnt = cnt + 1 end
                        end
                    end
                end
            end
            if cnt > bestCount then bestCount, best = cnt, b end
        end
        -- 3) klaster = wszystko w R*1.4 od best; reszta = reszta mapy
        if best and bestCount >= 3 then
            local cluster, rest = {}, {}
            local RR = (R * 1.4) ^ 2
            for _, b in ipairs(bottles) do
                local d = b.pos - best.pos
                if (d.X * d.X + d.Z * d.Z) <= RR then cluster[#cluster + 1] = b
                else rest[#rest + 1] = b end
            end
            -- greedy NN wewnątrz klastra od gracza, potem reszta od końca klastra
            local function greedyNN(list, start)
                local remaining = {}
                for _, v in ipairs(list) do remaining[#remaining + 1] = v end
                local route, cur = {}, start
                while #remaining > 0 do
                    local bi, bd = 1, math.huge
                    for i, b in ipairs(remaining) do
                        local d = (cur - b.pos).Magnitude
                        if d < bd then bd, bi = d, i end
                    end
                    local pick = table.remove(remaining, bi)
                    route[#route + 1] = pick
                    cur = pick.pos
                end
                return route
            end
            local r1 = greedyNN(cluster, fromPos)
            local tailStart = (#r1 > 0) and r1[#r1].pos or fromPos
            local r2 = greedyNN(rest, tailStart)
            for _, v in ipairs(r2) do r1[#r1 + 1] = v end
            return r1
        end
    end

    -- fallback: globalny greedy NN od gracza
    local remaining = {}
    for _, v in ipairs(orderPool) do remaining[#remaining + 1] = v end
    local route, cur = {}, fromPos
    while #remaining > 0 do
        local bi, bd = 1, math.huge
        for i, b in ipairs(remaining) do
            local d = (cur - b.pos).Magnitude
            if d < bd then bd, bi = d, i end
        end
        local pick = table.remove(remaining, bi)
        route[#route + 1] = pick
        cur = pick.pos
    end
    return route
end

--// TWEEN (płynny dolot; serwer widzi replikowaną pozycję i akceptuje prompt) //--
local function tweenTo(targetPos)
    local h = hrp()
    if not h then return end
    if currentTween then pcall(function() currentTween:Cancel() end); currentTween = nil end
    local dist = (h.Position - targetPos).Magnitude
    if dist < 0.5 then return end
    local dur = math.clamp(dist / math.max(CFG.Speed, 1), 0.03, 6)
    local tw = TweenService:Create(h, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = CFrame.new(targetPos) })
    currentTween = tw
    tw:Play()
    tw.Completed:Wait()
    if currentTween == tw then currentTween = nil end
    standUp()
end

--// MASOWY FIRE, ale TYLKO gdy gracz <= ArriveRadius (2m) od butelki //--
local fireFn = (typeof(fireproximityprompt) == "function") and fireproximityprompt or nil

local function fireSingle(prompt)
    if not prompt or not prompt.Parent then return false end
    -- BottleClient ustawia Enabled=false poza Detailed — włączamy na chwilę
    pcall(function()
        prompt.Enabled = true
        prompt.RequiresLineOfSight = false
        if prompt.MaxActivationDistance < 4 then prompt.MaxActivationDistance = 5 end
    end)
    if fireFn then
        local ok = pcall(function() fireFn(prompt) end)
        return ok
    else
        -- fallback gdyby executor nie miał fireproximityprompt
        pcall(function()
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration + 0.05)
            prompt:InputHoldEnd()
        end)
        return true
    end
end

--// ZBIÓR (sprawdzony wariant: fire + burst + krótkie waity na rejestrację) //--
local function tryCollect(entry)
    local h = hrp()
    if not h or not entry.model.Parent then return false end
    -- TWARDY WARUNEK: gracz musi być w <= ArriveRadius (2m)
    if (h.Position - entry.pos).Magnitude > CFG.ArriveRadius + 0.6 then return false end
    local before = entry.model.Parent
    if entry.prompt then fireSingle(entry.prompt) end
    task.wait(0.08)
    -- MASOWO: dobij wszystko w BurstR (też tylko te blisko gracza)
    local folder = Workspace:FindFirstChild("Butelki")
    if folder then
        local hh = hrp()
        local hp = hh and hh.Position
        if hp then
            local burst = 0
            for _, m in ipairs(folder:GetChildren()) do
                if burst >= 8 then break end
                if m:IsA("Model") and m.Name == "Butelka" and m ~= entry.model then
                    local pp = bottlePos(m)
                    if pp and (hp - pp).Magnitude <= CFG.BurstR then
                        local pr = bottlePrompt(m)
                        if pr then fireSingle(pr); burst = burst + 1 end
                    end
                end
            end
        end
    end
    task.wait(0.05)
    -- zebrana = model znika z Butelki (serwer usuwa po podniesieniu)
    if not entry.model.Parent or entry.model.Parent ~= before then
        collectedTotal = collectedTotal + 1
        return true
    end
    return false
end

