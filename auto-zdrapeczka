local pathDots = {}
local function initPathOverlay(parentGui)
    -- posprzątaj starocie 3D po poprzednich wersjach
    local junk = Workspace:FindFirstChild("_BottlePath")
    if junk then pcall(function() junk:Destroy() end) end
    if getgenv().BF_RS then pcall(function() getgenv().BF_RS:Disconnect() end) end

    local ov = Instance.new("Frame")
    ov.Name = "_Path2D"
    ov.Size = UDim2.new(1, 0, 1, 0)
    ov.BackgroundTransparency = 1
    ov.Active = false
    ov.ZIndex = 1
    ov.Parent = parentGui

    for i = 1, 40 do
        local d = Instance.new("Frame")
        d.Size = UDim2.fromOffset(10, 10)
        d.Visible = false
        d.Active = false
        d.BackgroundColor3 = Color3.fromRGB(90, 255, 150)
        d.BorderSizePixel = 0
        d.ZIndex = 2
        d.Parent = ov
        local u = Instance.new("UICorner")
        u.CornerRadius = UDim.new(1, 0)
        u.Parent = d
        pathDots[i] = d
    end

    getgenv().BF_RS = RunService.RenderStepped:Connect(function()
        local cam = Workspace.CurrentCamera
        local h = hrp()
        if not CFG.ShowPath or not running or not h or not cam then
            for _, d in ipairs(pathDots) do d.Visible = false end
            return
        end
        local n = 0
        for i, wp in ipairs(curRoute) do
            if n >= 40 then break end
            if wp.model.Parent then
                local sp, onScr = cam:WorldToViewportPoint(wp.pos + Vector3.new(0, 2.5, 0))
                if onScr and (h.Position - wp.pos).Magnitude > 3 then
                    n = n + 1
                    local d = pathDots[n]
                    d.Position = UDim2.fromOffset(sp.X - 5, sp.Y - 5)
                    -- kolor = TYP butelki (specjalne widać z daleka), rozmiar = priorytet w trasie
                    local cc = TYPECOLORS[wp.btype] or TYPECOLORS.normalna
                    if i == 1 then
                        d.Size = UDim2.fromOffset(14, 14)
                        d.BackgroundColor3 = Color3.fromRGB(255, 220, 80)
                    else
                        d.Size = UDim2.fromOffset(10, 10)
                        d.BackgroundColor3 = Color3.fromRGB(cc[1], cc[2], cc[3])
                    end
                    d.Visible = true
                end
            end
        end
        for j = n + 1, 40 do pathDots[j].Visible = false end
    end)
end

