local function scrInvList()
    local key = CFG.SCR_Card
    local okI, inv = pcall(function() return SCR_R:InvokeServer("GetInventory") end)
    local list = {}
    if okI and inv and inv.Success and inv.Inventory then
        for i = #inv.Inventory, 1, -1 do
            if inv.Inventory[i].CardType == key then list[#list + 1] = inv.Inventory[i].Id end
        end
    end
    return list
end

-- InvokeServer z TIMEOUTEM (serwer potrafi zawiesić odpowiedź, np. throttle kupna).
-- Porzucone wywołanie i tak kiedyś dojdzie (karta wyląduje w eq i weźmie ją refill).
local function invokeT(fn, secs)
    local done, res = false, nil
    task.spawn(function()
        res = { pcall(fn) }
        done = true
    end)
    local t0 = os.clock()
    while not done and os.clock() - t0 < (secs or 8) do task.wait(0.05) end
    if not done then return false, "timeout" end
    return table.unpack(res)
end

-- Cache ID: inventory TYLKO gdy może coś być (flaga scrNoStock); kupno POJEDYNCZE.
-- BuyCard zwraca CardId, więc po kupnie nie trzeba odpytywać inventory.
local scrIDCache, scrCacheKey, scrNoStock = {}, nil, false

local function scrRefill()
    local key = CFG.SCR_Card
    if scrCacheKey ~= key then scrIDCache, scrCacheKey, scrNoStock = {}, key, false end
    if #scrIDCache == 0 and not scrNoStock then
        for _, id in ipairs(scrInvList()) do scrIDCache[#scrIDCache + 1] = id end
        if #scrIDCache == 0 then scrNoStock = true end -- pusto: dalej prosto do sklepu
    end
    if #scrIDCache == 0 and CFG.SCR_Buy then
        local okB, br = invokeT(function() return SCR_R:InvokeServer("BuyCard", key, 1) end, 8)
        if okB and br and br.Success and br.CardId then
            scrIDCache[#scrIDCache + 1] = br.CardId
            scrStats.cost = scrStats.cost + cardCost(key)
        elseif br == "timeout" then
            return false, "timeout"
        else
            return false, "buy:" .. tostring(br and br.Error or "brak kasy?")
        end
    end
    scrInvN = #scrIDCache
    if #scrIDCache == 0 then return false, "pusto (sklep OFF)" end
    return true
end

local function scrCycle()
    if #scrIDCache == 0 then
        local ok, err = scrRefill()
        if not ok then return false, err end
    end
    local id = table.remove(scrIDCache)
    scrInvN = #scrIDCache
    local okU, ur = invokeT(function() return SCR_R:InvokeServer("UseCard", id) end, 8)
    if not (okU and ur and ur.Success) then
        pcall(function() SCR_R:InvokeServer("CancelScratch") end)
        return false, (ur == "timeout" and "timeout" or "use")
    end
    local key = CFG.SCR_Card
    plr:SetAttribute("ActiveCardType", key)
    plr:SetAttribute("BlockVisualCashUpdate", true)
    plr:SetAttribute("ScratchPercent", 1)
    -- 4) rozliczenie BEZ rysowania (canvas to teatrzyk)
    local okC, cr = invokeT(function() return SCR_R:InvokeServer("CompleteScratch") end, 8)
    plr:SetAttribute("BlockVisualCashUpdate", false)
    if not okC then
        pcall(function() SCR_R:InvokeServer("CancelScratch") end)
        return false, "complete"
    end
    local win = 0
    if type(cr) == "table" then win = tonumber(cr.WinAmount) or 0 end
    scrStats.n = scrStats.n + 1
    scrStats.won = scrStats.won + win
    if win > scrStats.big then scrStats.big = win end
    return true, win
end

local function scratchLoop()
    if scrBusy then return end
    scrBusy = true
    scrErr = 0
    -- ubezpieczenie: gdyby wisiała niedokończona karta, serwer blokuje nowe UseCard
    pcall(function() SCR_R:InvokeServer("CancelScratch") end)
    refreshScr("start...")
    while scrRunning do
        if scrStats.n >= CFG.SCR_Limit then
            refreshScr("limit " .. CFG.SCR_Limit .. " osiągnięty")
            break
        end
        local ok, r = scrCycle()
        if ok then
            scrErr = 0
            refreshScr("+" .. tostring(r) .. " zł (max " .. scrStats.big .. ")")
        else
            scrErr = scrErr + 1
            refreshScr("ERR " .. tostring(r) .. " (" .. scrErr .. "/3)")
            if tostring(r):find("buy") or scrErr >= 3 then break end -- brak kasy / 3 błędy z rzędu
        end
        task.wait(CFG.SCR_Tempo)
    end
    scrBusy = false
    scrRunning = false
    refreshScr("stop")
end

--// GŁÓWNA PĘTLA //--
local function farmLoop()
    if busy then return end
    busy = true
    stopReq = false
    setNoclip(true)
    setStatus("Skanuję butelki...", Color3.fromRGB(90, 180, 255))

    while running and not stopReq do
        local h = hrp()
        if not h then
            setStatus("Czekam na postać...", Color3.fromRGB(255, 170, 70))
            task.wait(1)
        else
            local bottles = scanBottles()
            local specN = 0
            for _, b in ipairs(bottles) do
                if (b.value or 0.5) > 0.5 then specN = specN + 1 end
            end
            count.Text = "  Butelki: " .. #bottles .. " (SPEC " .. specN .. ")  •  zebrano: " .. collectedTotal
            if #bottles == 0 then
                setStatus("Brak butelek — czekam na resp...", Color3.fromRGB(140, 148, 165))
                hidePath()
                task.wait(2)
            else
                local route = planRoute(bottles, h.Position)
                drawPath(route, h.Position)
                setStatus("Celów: " .. #route .. " • klaster R=" .. CFG.ClusterR, Color3.fromRGB(90, 180, 255))

                for idx, entry in ipairs(route) do
                    if not running or stopReq then break end
                    if entry.model.Parent then
                        h = hrp(); if not h then break end
                        -- TWEEN nad butelkę (hover ≈2m, czyli w limicie fire)
                        local target = entry.pos + Vector3.new(0, CFG.HoverH, 0)
                        if (h.Position - target).Magnitude > CFG.ArriveRadius then
                            setStatus("Lot " .. idx .. "/" .. #route, Color3.fromRGB(90, 180, 255))
                            pcall(tweenTo, target)
                        end
                        if not running or stopReq then break end

                        -- mikro-korekta gdyby fizyka zniosła (tween, nie TP)
                        h = hrp()
                        if h and (h.Position - entry.pos).Magnitude > CFG.ArriveRadius + 0.6 then
                            pcall(tweenTo, entry.pos + Vector3.new(0, math.min(CFG.HoverH, 2), 0))
                            h = hrp()
                        end

                        -- FIRE tylko gdy realnie blisko (twardy warunek 2m)
                        h = hrp()
                        if h and entry.model.Parent then
                            local d2 = (h.Position - entry.pos).Magnitude
                            if d2 <= CFG.ArriveRadius + 0.6 then
                                setStatus("Zbieram " .. idx .. "/" .. #route, Color3.fromRGB(120, 220, 130))
                                local okc = false
                                for _ = 1, 3 do
                                    if tryCollect(entry) then okc = true; break end
                                    task.wait(0.1)
                                    if not entry.model.Parent then
                                        okc = true
                                        collectedTotal = collectedTotal + 1
                                        break
                                    end
                                end
                                if okc then
                                    count.Text = "  Butelki: " .. #scanBottles() .. "  •  zebrano: " .. collectedTotal
                                end
                                task.wait(CFG.Dwell)
                            end
                        end

                        -- odśwież 2D co 10 celów (reszta trasy) + ewentualna sprzedaż
                        if idx % 10 == 0 then
                            local fresh = {}
                            for j = idx + 1, #route do
                                if route[j].model.Parent then fresh[#fresh + 1] = route[j] end
                            end
                            drawPath(fresh)
                            -- próg na PLECAK (nie licznik): burst-zbiory też lądują w toolse
                            if CFG.AutoSell and countTools() >= CFG.SellEvery then
                                goSell()
                            end
                        end
                    end -- if entry.model.Parent
                end
                count.Text = "  Butelki: " .. #scanBottles() .. "  •  zebrano: " .. collectedTotal
                if CFG.AutoSell and countTools() >= CFG.SellEvery then
                    goSell() -- 500 w plecaku: sprzedaż i powrót, potem re-skan
                end
                task.wait(0.3) -- re-skan po pełnym obiegu (respawn butelek)
            end
        end
    end

    setNoclip(false)
    pcall(function() local hh = hrp() if hh then hh.Anchored = false end end) -- na pewno odkotwicz
    if currentTween then pcall(function() currentTween:Cancel() end); currentTween = nil end
    hidePath()
    busy = false
    if stopReq then setStatus("STOP — zebrano: " .. collectedTotal, Color3.fromRGB(255, 120, 120)) end
end

startB.MouseButton1Click:Connect(function()
    if running then return end
    if not Workspace:FindFirstChild("Butelki") then
        setStatus("Brak folderu Butelki!", Color3.fromRGB(255, 120, 120))
        return
    end
    running = true
    setStatus("START...", Color3.fromRGB(120, 220, 130))
    task.spawn(farmLoop)
end)

stopB.MouseButton1Click:Connect(function()
    stopReq = true
    running = false
    setStatus("STOP...", Color3.fromRGB(255, 120, 120))
end)

closeB.MouseButton1Click:Connect(function()
    running = false; stopReq = true
    setNoclip(false)
    if currentTween then pcall(function() currentTween:Cancel() end) end
    hidePath()
    gui:Destroy()
end)

plr.CharacterAdded:Connect(function()
    task.wait(1)
    if running and not busy then task.spawn(farmLoop) end
end)

setStatus("Gotowy — ustaw suwaki i kliknij START")
count.Text = "  Butelki: " .. #scanBottles() .. "  •  zebrano: 0"

-- haki do sterowania / diagnostyki z konsoli executora (getgenv działa między wywołaniami)
getgenv().BF_GO = function()
    if running then return "already" end
    running = true
    task.spawn(farmLoop)
    return "started"
end
getgenv().BF_STOP = function()
    stopReq = true
    running = false
    return "stopped"
end
getgenv().BF_STAT = function()
    return { running = running, busy = busy, got = collectedTotal, n = #scanBottles() }
end
getgenv().BF_SELLN = function(n)
    CFG.SellEvery = n
    return n
end
getgenv().BF_SCRGO = function()
    if scrRunning then return "already" end
    scrRunning = true
    task.spawn(scratchLoop)
    return "started"
end
getgenv().BF_SCRSTOP = function()
    scrRunning = false
    return "stopped"
end
getgenv().BF_SCRSTAT = function()
    return { run = scrRunning, n = scrStats.n, cost = scrStats.cost, won = scrStats.won, big = scrStats.big, eq = scrInvN, card = CFG.SCR_Card }
end
getgenv().BF_CARD = function(k)
    for i, key in ipairs(CARDS) do
        if key == k then CARDI = i CFG.SCR_Card = k refreshCard() return k end
    end
    return nil
end
getgenv().BF_AF = function()
    return antiConn ~= nil
end
-- pierwsze N celów trasy (do weryfikacji priorytetu): zwraca typy, np. {"zlota",...}
getgenv().BF_PEEK = function(n)
    local h = hrp()
    if not h then return {} end
    local r = planRoute(scanBottles(), h.Position)
    local o = {}
    for i = 1, math.min(n or 5, #r) do o[#o + 1] = r[i].btype or "?" end
    return o
end
